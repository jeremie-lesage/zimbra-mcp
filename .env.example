# Configuration Zimbra MCP

# URL du serveur SOAP Zimbra
ZIMBRA_URL=https://mail.example.com/service/soap

# Identifiants Zimbra
ZIMBRA_USER=user@example.com
ZIMBRA_PASSWORD=your_password_here

# Timeout des requêtes en secondes (optionnel, défaut: 30)
ZIMBRA_TIMEOUT=30

# Activer l'envoi d'emails (optionnel, défaut: false)
# ATTENTION : permet l'envoi direct d'emails depuis le serveur MCP
ZIMBRA_ENABLE_SEND=false

# Autoriser la suppression définitive des emails/contacts (optionnel, défaut: false)
# Sinon, les suppressions vont toujours dans la Corbeille
ZIMBRA_ENABLE_HARD_DELETE=false

# Seul dossier où download_attachment peut écrire (optionnel, défaut: aucune restriction)
# ZIMBRA_DOWNLOAD_DIR=~/Downloads

# Taille max d'une pièce jointe téléchargée, en Mo (optionnel, défaut: 50)
ZIMBRA_MAX_ATTACHMENT_MB=50

# Accepter une ZIMBRA_URL en http:// (optionnel, défaut: false)
# ATTENTION : mot de passe et token transitent alors en clair
ZIMBRA_ALLOW_INSECURE_HTTP=false
