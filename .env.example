# Configuration Zimbra MCP

# URL du serveur SOAP Zimbra
ZIMBRA_URL=https://mail.example.com/service/soap

# Identifiants Zimbra
ZIMBRA_USER=user@example.com
ZIMBRA_PASSWORD=your_password_here

# Timeout des requêtes en secondes (optionnel, défaut: 30)
ZIMBRA_TIMEOUT=30

# Activer l'envoi d'emails (optionnel, défaut: false)
# ATTENTION : permet l'envoi direct d'emails depuis le serveur MCP
ZIMBRA_ENABLE_SEND=false
